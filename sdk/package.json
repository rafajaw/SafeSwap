{
  "name": "@safeswap/sdk",
  "version": "0.0.1",
  "description": "TypeScript SDK for SafeSwap — MEV protection for traders and repricing revenue for LPs.",
  "type": "module",
  "main": "./dist/SafeSwap.js",
  "module": "./dist/SafeSwap.js",
  "types": "./dist/sdk/SafeSwap.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/SafeSwap.d.ts",
      "import": "./dist/SafeSwap.js",
      "default": "./dist/SafeSwap.js"
    },
    "./source": "./SafeSwap.ts"
  },
  "files": [
    "dist",
    "SafeSwap.ts",
    "README.md"
  ],
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "bun build SafeSwap.ts --outdir dist --format esm --external viem --external @bondroute/sdk",
    "build": "rm -rf dist && bun run build:types && bun run build:js",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@bondroute/sdk": "*",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@bondroute/sdk": "file:../lib/BondRoute/sdk",
    "@types/bun": "^1.3.14",
    "typescript": "^5.4.0",
    "viem": "^2.50.4"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
