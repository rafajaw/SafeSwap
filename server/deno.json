    "@bondroute/sdk": "../lib/BondRoute/sdk/BondRoute.ts",
    "@safeswap/sdk": "../sdk/SafeSwap.ts"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"]
  }
}
