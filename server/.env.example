# SafeSwap relayer — copy to .env and fill in. The relayer key is the only secret; keep it server-side.
# Note: the mined SafeSwap/BondRoute contract addresses are identical on every chain and hardcoded in config.ts — not here.

# HTTP
PORT=8080
STATIC_DIR=../frontend/dist

# Chain — example: Unichain Sepolia (testnet)
RELAYER_RPC_URL=https://sepolia.unichain.org
RELAYER_CHAIN_ID=1301

# The relayer's funded account — its private key signs every sponsored transaction.
RELAYER_PRIVATE_KEY=0x...

# Native-token USD price. REQUIRED in practice: the gas-cost ceiling is fail-closed, so the relayer refuses to sponsor
# unless this is set (it cannot price the < $1 ceiling otherwise).
RELAYER_NATIVE_USD_PRICE=3500

# Optional: reveal delay the relayer waits between the commit and execute transactions (defaults: 4 blocks / 4 seconds,
# clearing SafeSwap's 3-block / 2-second floor with margin).
# RELAYER_REVEAL_DELAY_BLOCKS=4
# RELAYER_REVEAL_DELAY_SECONDS=4

# Activity store. With DATABASE_URL set, gasless bonds are tracked in postgres (durable, multi-instance-safe — required under
# green/blue so two app containers never collide on the relayer nonce). Unset → an in-process memory store (local dev / tests).
# In the docker deploy this is injected automatically (postgresql://user:pass@postgresql:5432/dbname).
# DATABASE_URL=postgresql://dbuser:dbpass@localhost:5432/safeswap

# Optional: how many settled bonds per address GET /activity returns under "recent" (default 20).
# RELAYER_RECENT_LIMIT=20
