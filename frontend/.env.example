# SafeSwap frontend — copy to .env (or .env.local) and fill in. All build-time via Vite, so they are PUBLIC; never put a
# secret here (the relayer's private key lives only in the server).

# Canonical SafeSwap addresses for the target chain (from the deploy).
VITE_SAFESWAP_ROUTER_ADDRESS=0x...
VITE_SAFESWAP_NFT_ADDRESS=0x...
# Optional: override the BondRoute singleton (defaults to the canonical address baked into the SDK).
# VITE_BONDROUTE_ADDRESS=0x...

# Gasless (EIP-7702). All three are required for Gasless to be offered; otherwise the app falls back to self-execute.
VITE_SAFESWAP_RELAYER_DELEGATE_ADDRESS=0x...   # the 7702 delegation target (the SafeSwap7702Delegate contract)
VITE_SAFESWAP_RELAYER_ADDRESS=0x...            # the relayer's funded EOA (submits txns, is the signed `relayer`) — NOT the delegate
# The relayer endpoint; defaults to same-origin /relay. Override for a separately-hosted relayer.
# VITE_RELAY_URL=/relay
